# Copy to .env. Every variable is optional; defaults run the full demo offline.

# Connector mode for all apps: DEMO | REAL | DISABLED
SURGE_CONNECTOR_MODE=DEMO
# Per-app overrides (uncomment to mix live and seeded connectors)
# SURGE_GITHUB_MODE=REAL
# SURGE_SLACK_MODE=REAL
# SURGE_SHEETS_MODE=REAL

# Reasoning: auto (LLM when a Groq or Gemini key is present) | llm | heuristic
SURGE_REASONING_MODE=auto
# Free-tier hybrid router. Primary provider's chain is tried first; secondary takes over only
# when every primary model is rate limited, out of daily quota, or failing. Then heuristics.
SURGE_LLM_PRIMARY=groq
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Never commit your real .env. It is git-ignored, and a local pre-commit hook blocks key-shaped strings.
SURGE_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,qwen/qwen3.6-27b
SURGE_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
SURGE_LLM_REASONING_EFFORT=low
# Cooldowns used when a provider gives no retry hint
SURGE_LLM_RATE_LIMIT_COOLDOWN_S=20
SURGE_LLM_QUOTA_COOLDOWN_S=3600
SURGE_LLM_ERROR_COOLDOWN_S=15
# If every model is cooling down, wait this long for the soonest one before using heuristics
SURGE_LLM_MAX_WAIT_S=8

# Demo behaviour
SURGE_DEMO_SCENARIO=checkout_regression_01
# Simulated provider latency for seeded connectors (disclosed in /api/connectors)
SURGE_DEMO_LATENCY_MS=350

# Security and URLs
SURGE_SECRET_KEY=change-me-to-a-long-random-string
SURGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SURGE_FRONTEND_URL=http://localhost:3000
SURGE_PUBLIC_BASE_URL=http://localhost:8000

# GitHub (OAuth app or a fine-grained token with Issues read/write + Contents/Deployments read)
SURGE_GITHUB_REPO=
SURGE_GITHUB_TOKEN=
SURGE_GITHUB_CLIENT_ID=
SURGE_GITHUB_CLIENT_SECRET=

# Slack (user token with search:read, or bot token with channels:history + channel allowlist)
SURGE_SLACK_USER_TOKEN=
SURGE_SLACK_BOT_TOKEN=
SURGE_SLACK_CHANNELS=
SURGE_SLACK_CLIENT_ID=
SURGE_SLACK_CLIENT_SECRET=

# Google Sheets (OAuth, or an access/refresh token with spreadsheets.readonly)
SURGE_SHEETS_SPREADSHEET_ID=
SURGE_SHEETS_TAB=metrics_hourly
SURGE_GOOGLE_CLIENT_ID=
SURGE_GOOGLE_CLIENT_SECRET=
SURGE_GOOGLE_ACCESS_TOKEN=
SURGE_GOOGLE_REFRESH_TOKEN=
