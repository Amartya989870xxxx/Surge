# Copy to .env and fill in your own Firebase project's web config.
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup.
# These values identify your Firebase project to Google; they are not secret in the way a
# server API key is (Firebase enforces access via Security Rules / backend token verification,
# not by hiding this config) - but each deployment should still use its own project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
